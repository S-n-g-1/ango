# Normalize line endings in the repository; check out native endings.
* text=auto

# Scripts must keep the line endings their interpreter expects.
*.sh   text eol=lf
Makefile text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ttf  binary
*.ogg  binary
*.wav  binary
*.mp3  binary
