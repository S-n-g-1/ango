# chapter1.ango
namespace chapter1

label opening
"Bel masuk sudah berbunyi, tapi kelas 2-B masih riuh seperti pasar."
show asep "Calm" at left with fade 0.4
Asep: "Hujan lagi. Semoga atap di pojok belakang tidak bocor seperti minggu lalu."
"Seseorang menepuk bahumu dari belakang."
show asep "Astonishment" at right flip with fade 0.4
Dina: "Pagi, [player_name]! Kamu sudah mengerjakan PR Bu Rina?"
choice:
    "Sudah dong. Mau lihat?":
        set dina_trust = dina_trust + 1
        show asep "Smile" at right with fade 0.4
        Dina: "Kamu penyelamat!"
        jump kelas
    "Belum... aku lupa total.":
        show asep "Embarrassment" at right with fade 0.4
        Dina: "Sama! Kita berdua habis."
        jump kelas

label kelas
show asep "Calm" at center with fade 0.4
"Pintu kelas terbuka. Seisi ruangan langsung diam."
"Bu Rina": "Selamat pagi, anak-anak. Duduk di tempat masing-masing."
"Kamu menarik kursi dan duduk. Tanganmu menyentuh sesuatu di dalam laci meja."
show asep "Doubt" at center with fade 0.4
"Selembar kertas lipat. Kemarin laci ini masih kosong."
choice:
    "Buka kertasnya sekarang":
        set baca_surat = true
        jump surat
    "Biarkan dulu, Bu Rina sedang menerangkan":
        Asep: "Nanti saja. Bu Rina bisa marah kalau ketahuan."
        jump pelajaran

label surat
show asep "Skepticism" at left with fade 0.4
"Tulisan tangan yang rapi, tapi tintanya terlihat masih basah."
"Isinya cuma satu kalimat: 'Jangan pulang sebelum bel ketiga.'"
Asep: "Bel ketiga? Sekolah ini cuma punya bel masuk dan bel pulang."
choice:
    "Tunjukkan ke Dina":
        set dina_trust = dina_trust + 1
        show asep "Skepticism" at right with fade 0.4
        Dina: "Ih, serem. Mungkin cuma iseng anak kelas sebelah."
        jump pelajaran
    "Simpan sendiri":
        set courage = courage + 1
        show asep "Thoughtfulness" at left with fade 0.4
        Asep: "Belum tentu iseng. Aku simpan dulu."
        jump pelajaran

label pelajaran
"Pelajaran berjalan lambat. Hujan terus mengetuk jendela."
if baca_surat:
    show asep "Thoughtfulness" at left flip
    show dina "Talk" at right flip
    Asep: "Kenapa aku tidak bisa berhenti memikirkan kalimat itu?"
else:
    "Kertas di dalam laci itu terus mengganggu pikiranmu, walau belum kamu buka."
"Tiba-tiba lampu kelas berkedip. Sekali. Dua kali. Lalu padam."
show asep "Fear" at center with fade 0.4
"Bu Rina": "Tenang, hanya listrik. Tetap di tempat."
"Dan di tengah gelap, sebuah bel berbunyi. Padahal ini belum jam istirahat."
jump chapter2.opening
